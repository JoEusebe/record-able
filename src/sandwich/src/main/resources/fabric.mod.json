{
  "schemaVersion": 1,
  "id": "recordable",
  "version": "${version}",
  "name": "Record-able",
  "description": "Tired of opening obs? Want your session to be more... record-able? this is the right mod for the job! highly configurable and helpful!!!",
  "authors": [
    "omniversial aka JoEusebe"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/record-able",
    "issues": "https://modrinth.com/mod/record-able",
    "sources": "https://modrinth.com/mod/record-able"
  },
  "license": "MIT",
  "icon": "assets/recordable/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.recordable.RecordableModInit"
    ],
    "modmenu": [
      "dev.recordable.compat.ModMenuIntegration"
    ],
    "voicechat": [
      "dev.recordable.RecordableVoicechatPlugin"
    ]
  },
  "mixins": [
    "recordable.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.15.0",
    "fabric-api": "*",
    "owo": "*",
    "minecraft": ">=1.21.6 <26.0",
    "java": ">=21"
  },
  "suggests": {
    "modmenu": "*",
    "craftpresence": "*"
  }
}
